{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shimamura-export-scout-live",
  "main": "src/index.js",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["0 23 * * *"]
  }
}
